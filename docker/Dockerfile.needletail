# M3-D Needletail execution image (pinned digests; built from a frozen
# git archive, never from a live checkout mount).
FROM swift:6.4-bookworm@sha256:d1bbd901832322ba5590888d687419e199b3a4d693db476c8aadba44038f8b18 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# Launcher stages needletail-src.tar.gz via `git archive` of the frozen SHA.
COPY needletail-src.tar.gz /src/
RUN tar xzf needletail-src.tar.gz && rm needletail-src.tar.gz
RUN swift build -c release --product needletail -j $(nproc)
RUN mkdir -p /out/bin /out/lib && cp .build/release/needletail /out/bin/needletail.real && \
    ldd .build/release/needletail | awk '/=> \// {print $1, $3}' | awk '$1 ~ /^(libswift|libdispatch|libFoundation|libFoundationEssentials|libFoundationInternationalization|libBlocksRuntime|lib_FoundationICU|lib_FoundationCURL|libsqlite3)/ {print $2}' | sort -u | while read -r lib; do cp "$lib" /out/lib/; done && \
    printf '#!/bin/sh\nexport LD_LIBRARY_PATH="/opt/needletail/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\nexec /opt/needletail/bin/needletail.real "$@"\n' > /out/bin/needletail && chmod +x /out/bin/needletail

FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN useradd -m -u 10000 bench && mkdir -p /workspace /state /grant /cfg && chown bench:bench /workspace /state /grant /cfg
COPY --from=builder /out /opt/needletail
USER bench
WORKDIR /workspace
ENTRYPOINT ["/opt/needletail/bin/needletail"]
