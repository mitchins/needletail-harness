# M3-D Pi execution image (pinned node base + installed Pi 1.4.0 dist).
# Symmetric model tooling: node 24 (base) + python3 for model-driven
# verification; no swiftc/php (oracles cover those).
FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10000 bench && mkdir -p /workspace /state /home/bench/.pi/agent && chown -R bench:bench /workspace /state /home/bench
# Launcher stages pi-dist/ (copy of the installed 1.4.0 package dir),
# models.json (halogen-only, frozen) and settings.json.
COPY --chown=bench:bench pi-dist /opt/pi
COPY --chown=bench:bench pi-models.json /home/bench/.pi/agent/models.json
COPY --chown=bench:bench pi-settings.json /home/bench/.pi/agent/settings.json
USER bench
WORKDIR /workspace
ENTRYPOINT ["node", "/opt/pi/dist/bundle/cli.js"]
